odel\":\"gpt-3.5-turbo\",\"timeout\":60000,\"max_retries\":2,\"configuration\":{\"baseURL\":\"https://api.openai.com/v1\",\"fetchOptions\":{}},\"model_kwargs\":{},\"use_responses_api\":true},\"response\":{\"response\":{\"generations\":[[{\"text\":\"Claro, para verificar suas pendências financeiras, preciso confirmar seu nome completo e e-mail cadastrado conosco. Poderia me fornecer essas informações?\"}]]},\"tokenUsageEstimate\":{\"completionTokens\":28,\"promptTokens\":392,\"totalTokens\":420}}}"}}
